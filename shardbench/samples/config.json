{
  "tables": [
    {
      "name": "t_user",
      "columns": ["user_id", "tenant_id", "user_name", "city"],
      "shard_key_columns": ["user_id"],
      "algorithm": "modulo",
      "params": { "base": 8 },
      "db_count": 2,
      "tables_per_db": 4
    },
    {
      "name": "t_order",
      "columns": ["order_id", "user_id", "tenant_id", "amount", "status"],
      "shard_key_columns": ["user_id", "tenant_id"],
      "algorithm": "modulo",
      "params": { "base": 6 },
      "db_count": 2,
      "tables_per_db": 3
    },
    {
      "name": "t_log_range",
      "columns": ["log_id", "event_time", "level"],
      "shard_key_columns": ["event_time"],
      "algorithm": "range",
      "params": {
        "boundaries": [100, 200, 300],
        "boundary_ownership": "lower"
      },
      "db_count": 2,
      "tables_per_db": 2
    },
    {
      "name": "t_cart_ring",
      "columns": ["cart_id", "member_id", "region"],
      "shard_key_columns": ["cart_id"],
      "algorithm": "consistent_hash",
      "params": {
        "nodes": [
          { "id": "node-a", "weight": 4 },
          { "id": "node-b", "weight": 2 },
          { "id": "node-c", "weight": 1 }
        ]
      },
      "db_count": 3,
      "tables_per_db": 1
    }
  ],
  "budget": {
    "global_concurrency": 3,
    "per_db_quota": 2,
    "wait_timeout_ms": 4000
  }
}
