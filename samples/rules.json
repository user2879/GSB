  "routes": [
    {
      "prefix": "/api/users",
      "service": "users",
      "timeout_ms": 300,
      "max_retries": 1
    },
    {
      "prefix": "/api/search",
      "service": "search",
      "timeout_ms": 300,
      "max_retries": 2
    },
    {
      "prefix": "/api/legacy",
      "service": "legacy",
      "timeout_ms": 250,
      "max_retries": 1
    }
  ]
}
