  "queries": [
    {
      "name": "q_status",
      "sql": "SELECT status_code, COUNT(*) AS order_count, SUM(amount) AS total_amount, MIN(amount) AS min_amount, MAX(amount) AS max_amount FROM orders WHERE status_code IN (1, 2) AND (amount >= 10) GROUP BY status_code ORDER BY total_amount DESC"
    },
    {
      "name": "q_segment",
      "sql": "SELECT segment_id, COUNT(*) AS customer_count, SUM(credit_limit) AS total_limit FROM customers WHERE active = 1 AND credit_limit >= 100 GROUP BY segment_id ORDER BY segment_id ASC"
    }
