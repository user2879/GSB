        {"id": "c3", "type": "copy", "params": {"src": "files/data.csv", "dst": "/c"}},
        {"id": "r1", "type": "run", "params": {"command": "${PYTHON} scripts/greet.py one", "inputs": ["scripts/greet.py"]}},
        {"id": "r2", "type": "run", "params": {"command": "${PYTHON} scripts/greet.py two", "inputs": ["scripts/greet.py"]}}
      ]
    }
  ]
}
