{
  "revision": 2,
  "rules": [
    {
      "id": "catalog-route",
      "format_version": 3,
      "prefix": "/catalog",
      "target_service": "catalog",
      "instance_weights": {
        "catalog-a": 1,
        "catalog-b": 1
      },
      "timeout_ms": 200,
      "retries": 1,
      "circuit_threshold": 2,
      "cooldown_ms": 5000,
      "depends_on": ["service:checkout"]
    },
    {
      "id": "checkout-route",
      "format_version": 3,
      "prefix": "/checkout",
      "target_service": "checkout",
      "instance_weights": {
        "checkout-a": 2,
        "checkout-b": 1
      },
      "timeout_ms": 180,
      "retries": 1,
      "circuit_threshold": 2,
      "cooldown_ms": 5000,
      "depends_on": ["service:catalog"]
    },
    {
      "id": "orders-route",
      "format_version": 3,
      "prefix": "/orders",
      "target_service": "orders",
      "instance_weights": {
        "orders-a": 1,
        "orders-b": 1
      },
      "timeout_ms": 120,
      "retries": 1,
      "circuit_threshold": 2,
      "cooldown_ms": 5000,
      "depends_on": ["rule:checkout-route", "service:catalog"]
    },
    {
      "id": "inventory-route",
      "format_version": 3,
      "prefix": "/inventory",
      "target_service": "inventory",
      "instance_weights": {
        "inventory-a": 1,
        "inventory-b": 1
      },
      "timeout_ms": 160,
      "retries": 1,
      "circuit_threshold": 2,
      "cooldown_ms": 5000,
      "depends_on": ["rule:orders-route"]
    }
  ]
}
