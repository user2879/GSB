{
  "format_version": 1,
  "session_id": "minimal-two-stream",
  "declared_version": 1,
  "notes": "Small deterministic round-robin, state, and flow-ledger sample.",
  "connection": {
    "initial_window": 65535,
    "initial_stream_window": 65535,
    "max_concurrent_streams": 10,
    "max_frame_size": 16384,
    "scheduling_quantum": 3
  },
  "streams": [
    {
      "stream_id": 1,
      "priority": 1,
      "request_body_bytes": 50000
    },
    {
      "stream_id": 3,
      "priority": 2,
      "request_body_bytes": 22000
    }
  ],
  "events": [
    {
      "seq": 0,
      "arrival_ms": 0,
      "type": "window_update",
      "scope": "connection",
      "increment": 10000
    },
    {
      "seq": 1,
      "arrival_ms": 4,
      "type": "window_update",
      "scope": "stream",
      "stream_id": 1,
      "increment": 8000
    },
    {
      "seq": 2,
      "arrival_ms": 8,
      "type": "window_update",
      "scope": "stream",
      "stream_id": 3,
      "increment": 6000
    },
    {
      "seq": 3,
      "arrival_ms": 12,
      "type": "strategy_change",
      "strategy": "proportional"
    },
    {
      "seq": 4,
      "arrival_ms": 16,
      "type": "priority_change",
      "stream_id": 3,
      "priority": 1
    },
    {
      "seq": 5,
      "arrival_ms": 20,
      "type": "rst_stream",
      "stream_id": 3,
      "error_code": 8
    }
  ]
}
