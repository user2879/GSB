{
  "name": "local-loopback-chaos",
  "seed": 42,
  "budget": {
    "max_total_injections": 6,
    "max_parallel": 2,
    "max_observe_ms": 900
  },
  "sampling": {
    "interval_ms": 50,
    "min_samples": 3,
    "scale": 10000
  },
  "services": [
    {"id": "svc-a", "host": "127.0.0.1", "port": 0, "control_port": 0,
     "fixed_latency_ms": 5, "error_rate_ppm": 0, "rebuildable": true},
    {"id": "svc-b", "host": "127.0.0.1", "port": 0, "control_port": 0,
     "fixed_latency_ms": 8, "error_rate_ppm": 500, "rebuildable": true},
    {"id": "svc-c", "host": "127.0.0.1", "port": 0, "control_port": 0,
     "fixed_latency_ms": 4, "error_rate_ppm": 0, "rebuildable": true}
  ],
  "injections": [
    {"type": "latency", "target": "svc-a", "duration_ms": 600,
     "observe_ms": 600, "params": {"delay_ms": 120}},
    {"type": "error_rate", "target": "svc-a", "duration_ms": 600,
     "observe_ms": 600, "params": {"error_rate_ppm": 5000}},
    {"type": "suspend", "target": "svc-b", "duration_ms": 400,
     "observe_ms": 400, "params": {}},
    {"type": "kill", "target": "svc-b", "duration_ms": 400,
     "observe_ms": 400, "params": {"restart": true}},
    {"type": "latency", "target": "svc-c", "duration_ms": 500,
     "observe_ms": 500, "params": {"delay_ms": 80}},
    {"type": "error_rate", "target": "svc-c", "duration_ms": 500,
     "observe_ms": 500, "params": {"error_rate_ppm": 9000}}
  ]
}
