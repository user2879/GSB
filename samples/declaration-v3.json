    },
    {
      "name": "cache",
      "replicas": 1,
      "image": "registry.local/cache:7.4",
      "resource_limit": 512,
      "probe_ms": 1000,
      "labels": {"app": "cache", "env": "prod"},
      "parent_ref": "api-gateway"
    }
  ]
}
