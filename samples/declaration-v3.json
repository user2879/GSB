{
  "format_version": 3,
  "workloads": [
    {
      "name": "api-gateway",
      "replicas": 3,
      "image": "registry.local/gateway:1.27.0",
      "resource_limit": 1536,
      "probe_ms": 500,
      "labels": {"app": "gateway", "env": "prod"},
      "parent_ref": null
    },
    {
      "name": "worker",
      "replicas": 2,
      "image": "registry.local/worker:3.2.1",
