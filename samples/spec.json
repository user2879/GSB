{
  "format_version": 1,
  "metadata": {
    "name": "capacity-cost-bucketpack-demo",
    "description": "Deterministic two-source local sample with a bucket dependency chain."
  },
  "sources": [
    {
      "id": "orders",
      "seed": 20261120,
      "rows": 32,
      "primary_key": "order_id",
      "data_file": "data/orders.json",
      "columns": [
        {"name": "order_id", "type": "int", "min": 1000, "max": 9999},
        {"name": "spend", "type": "float", "min": 0.0, "max": 300.0, "precision": 2, "null_fill": 0.0},
        {"name": "region", "type": "int", "min": 0, "max": 5, "null_fill": 0},
        {"name": "items", "type": "int", "min": 1, "max": 8, "null_fill": 1}
      ],
      "null_bitmaps": {
        "order_id": "00000000000000000000000000000000",
        "spend": "00010000000000000001000000000000",
        "region": "00000001000000000000000000000000",
        "items": "00000000000000000000000000000000"
      }
    },
    {
      "id": "events",
      "seed": 20261121,
      "rows": 24,
      "primary_key": "event_id",
      "data_file": "data/events.json",
      "columns": [
        {"name": "event_id", "type": "int", "min": 5000, "max": 9999},
        {"name": "latency", "type": "float", "min": 0.0, "max": 200.0, "precision": 2, "null_fill": 0.0},
        {"name": "channel", "type": "int", "min": 0, "max": 4, "null_fill": 0},
        {"name": "weight", "type": "float", "min": 0.0, "max": 20.0, "precision": 2, "null_fill": 0.0}
      ],
      "null_bitmaps": {
        "event_id": "000000000000000000000000",
        "latency": "000010000001000000000000",
        "channel": "000000001000000000000000",
        "weight": "000000000000000000000000"
      }
    }
  ],
  "rules": [
    {
      "id": "orders.spend_band",
      "source": "orders",
      "input": {"kind": "column", "name": "spend"},
      "boundaries": [2500, 7500, 15000, 25000],
      "scale": 2
    },
    {
      "id": "orders.spend_half",
      "source": "orders",
      "input": {"kind": "bucket", "name": "orders.spend_band"},
      "boundaries": [1, 3],
      "scale": 0
    },
    {
      "id": "orders.region_band",
      "source": "orders",
      "input": {"kind": "column", "name": "region"},
      "boundaries": [1, 3, 4],
      "scale": 0
    },
    {
      "id": "orders.items_band",
      "source": "orders",
      "input": {"kind": "column", "name": "items"},
      "boundaries": [2, 5],
      "scale": 0
    },
    {
      "id": "orders.items_aux",
      "source": "orders",
      "input": {"kind": "bucket", "name": "orders.items_band"},
      "boundaries": [1, 2],
      "scale": 0
    },
    {
      "id": "events.latency_band",
      "source": "events",
      "input": {"kind": "column", "name": "latency"},
      "boundaries": [2000, 6000, 12000],
      "scale": 2
    },
    {
      "id": "events.latency_fine",
      "source": "events",
      "input": {"kind": "bucket", "name": "events.latency_band"},
      "boundaries": [0, 2],
      "scale": 0
    },
    {
      "id": "events.channel_band",
      "source": "events",
      "input": {"kind": "column", "name": "channel"},
      "boundaries": [1, 3],
      "scale": 0
    },
    {
      "id": "events.weight_band",
      "source": "events",
      "input": {"kind": "column", "name": "weight"},
      "boundaries": [50, 100, 150],
      "scale": 1
    }
  ],
  "statistics": [
    {
      "id": "orders.feature_cost",
      "source": "orders",
      "refs": ["orders.spend_band", "orders.spend_half", "orders.region_band", "orders.items_band"],
      "metric": "sum_counts"
    },
    {
      "id": "events.feature_cost",
      "source": "events",
      "refs": ["events.latency_band", "events.latency_fine", "events.channel_band", "events.weight_band"],
      "metric": "sum_counts"
    }
  ],
  "packing": {
    "rows_per_pack": 6,
    "pack_width_budget": 90,
    "global_width_budget": 160,
    "pack_quota_per_source": 1,
    "workers": 4
  },
  "accounting": {
    "unit_cost_micros": 7,
    "budget_micros": 1000000
  }
}
