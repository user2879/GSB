{
  "schema_version": "diagnostics-config-v1",
  "normalization": {
    "method": "weighted_linear",
    "raw_scale": 100.0,
    "slope": 1.0,
    "bias": 0.0,
    "output_scale": 1000.0,
    "clamp": true
  },
  "quantization": {
    "fixed_decimals": 3,
    "gear_exponent": 0,
    "rounding": "half_up",
    "bit_width": 32,
    "reference_bit_width": 33,
    "reference_fixed_decimals": 4
  },
  "top_k": 5,
  "max_candidates_per_request": 12,
  "channels": {
    "search": 1.1,
    "feed": 1.0,
    "recall": 0.8
  },
  "sampling": {
    "ratio": 0.4,
    "ratio_permille": 400,
    "quota_rounding": "floor",
    "remainder": "channel_name_asc",
    "scheme": "channel_stratified_aux_seeded_v1"
  },
  "concurrency": {
    "max_workers": 3
  },
  "budget": {
    "batch_point_budget": 22,
    "request_point_quota": 8
  },
  "tolerance": {
    "normalization_dequant": 0.05,
    "truncation_rank": 0,
    "sampling_quota": 0,
    "shuffle_position": 1
  },
  "v1_fields": {
    "request_id": 12,
    "seq": 4,
    "candidate_id": 10,
    "score_permille": 6,
    "select_code": 2,
    "separator": "|"
  },
  "cache_dir": "artifacts/cache",
  "snapshot_dir": "artifacts/state"
}
