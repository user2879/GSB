{
  "environment": "local-wsl-ubuntu",
  "concurrency": 3,
  "fixed_point": {
    "fraction_bits": 10,
    "quantization_tier": "standard",
    "tier_shifts": {
      "coarse": -2,
      "standard": 0,
      "fine": 2
    },
    "rounding_mode": "ROUND_HALF_UP",
    "boundary_threshold": 0.0,
    "score_temperature": 1.0
  },
  "match_budget_points": 700,
  "doc_quota_points": 300,
  "jv1_widths": {
    "doc_seq": 4,
    "fragment_seq": 4,
    "score_permille": 5,
    "pos_code": 4
  },
  "snapshot_dir": "artifacts/snapshot",
  "cache_path": "artifacts/pipeline-state/cache.json",
  "ledger_path": "artifacts/ledger.jsonl",
  "report_path": "artifacts/diagnostic-report.json"
}
