    },
    {
      "id": "fill",
      "type": "fill_missing",
      "version": 1,
      "upstream": [
        "types"
      ],
      "params": {
        "fill_value": 0
      }
    },
    {
      "id": "scale",
      "type": "normalize",
      "version": 1,
      "upstream": [
        "fill"
      ],
      "params": {
        "scale": 3,
        "divisor": 1,
        "rounding": "toward_zero"
      }
    },
    {
      "id": "clip",
      "type": "clip",
      "version": 1,
      "upstream": [
        "scale"
      ],
      "params": {
        "lower": -20000,
        "upper": 40000,
        "max_outlier_bp": 2000
      }
    },
    {
      "id": "pack",
      "type": "shard",
      "version": 1,
      "upstream": [
        "clip"
      ],
      "params": {
        "target_rows": 4,
        "remainder_rule": "keep_partial"
      }
    }
  ]
