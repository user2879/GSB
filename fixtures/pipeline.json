          "type": "int"
        },
        "score": {
          "type": "float"
        },
        "label": {
          "type": "int"
        }
      }
    }
  ],
  "stages": [
    {
      "id": "read",
      "type": "read",
      "version": 1,
      "upstream": [],
      "params": {
        "chunk_rows": 4,
        "source_ids": [
          "train_a",
          "train_b"
        ]
      }
    },
    {
      "id": "types",
      "type": "normalize_types",
      "version": 1,
      "upstream": [
